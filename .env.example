# ══════════ 应用 ══════════
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=瀚星 Super Image
# 生产必改：用户实际访问的完整地址（影响图片 URL 生成与 /uploads 同源校验）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ══════════ 数据库 / Redis（生产：1Panel 外部实例）══════════
# 直接用 1Panel 容器名做 host（应用容器加入 1panel-network 后可解析），
# PG/Redis 无需对宿主机暴露端口。注意 DATABASE_URL 末尾必须带 /库名。
# 版本要求：PostgreSQL ≥15（迁移用了 NULLS NOT DISTINCT）、Redis ≥6.2（GETDEL）。
DATABASE_URL=postgresql://user:password@1Panel-postgresql-xxxx:5432/hanxing_super
# Redis 有密码用 redis://:密码@容器名:6379 形式
REDIS_URL=redis://:password@1Panel-redis-xxxx:6379
# 1Panel 应用所在 docker 网络（默认 1panel-network；用
# docker inspect <pg容器名> --format '{{json .NetworkSettings.Networks}}' 核对）
PANEL_NETWORK=1panel-network

# ══════════ 数据库 / Redis（本地开发：docker-compose.dev.yml 自带实例）══════════
# 本地 pnpm dev 用下面的宿主机地址；生产 compose 只读上面两行，本段不生效。
POSTGRES_USER=hanxing
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=hanxing_super
# DATABASE_URL=postgresql://hanxing:change_me_in_prod@localhost:5432/hanxing_super
# REDIS_URL=redis://localhost:6379

# ══════════ 认证 ══════════
# Auth.js: 至少 32 字符随机串，生产必改
AUTH_SECRET=please_generate_with_openssl_rand_hex_32_min_length
AUTH_TRUST_HOST=true

# ══════════ 加密（API Key / COS SecretKey 落库加密）══════════
# 32 字符密钥；生产从密钥管理服务获取。
# ⚠️ 上线后不可更换：所有已加密落库的数据（模型 API Key、COS SecretKey、
# webhook 密钥）都依赖它，轮换需按 enc:v1: 前缀排查重录。
ENCRYPTION_KEY=change_me_32_chars_min_aaaaaaaa

# ══════════ 初始超管（首次启动种子） ══════════
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=             # 留空则启动时随机生成并打印控制台

# ══════════ 腾讯云 COS（可选，默认本地存储）══════════
# 生产推荐：留空，改在超管平台「系统设置」里配置（密钥加密落库）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=hanxing-super-xxxx
COS_REGION=ap-guangzhou
COS_BASE_URL=
COS_IMAGE_PREFIX=image/

# ══════════ AI 任务队列 ══════════
# /api/cron/* 的 Bearer token（必填，生产务必改为强随机值；worker 经 env 校验间接依赖）
CRON_SECRET=please_generate_a_strong_random_secret
QUEUE_POLL_INTERVAL_MS=2000
# 单 worker 进程内并行处理的任务数上限（保护 DB 连接池；跨进程总并发仍由企业/模型槽位约束）
WORKER_TASK_CONCURRENCY=8
# 转存下载并发上限：防止高并发波次打满服务器入方向带宽导致 30s 下载超时雪崩。
# 经验值 ≈ 入方向带宽 Mbps × 2 ÷ 平均图片 MB（12M 带宽、2MB 图 ≈ 16；30M 入 ≈ 40）
TRANSFER_CONCURRENCY=16
# 订阅套餐周期发放扫描间隔（毫秒，worker subscriptionLoop；幂等由发放台账唯一索引保证）
SUBSCRIPTION_POLL_INTERVAL_MS=60000

# ── /uploads 访问收紧（本地存储模式）──
# 无签名访问宽限期截止（ISO 日期）。/uploads 已改为「登录会话或 15 分钟 HMAC
# 令牌」二选一：浏览器 <img> 走会话；上游 AI 拉参考图 / 导出打包等服务端
# fetch 由代码自动附令牌。宽限期内无签名访问仍放行并打计数日志；到期后
# 强制 401。上线本项后设为「部署日 + 30 天」，到期观察日志归零后保持强制。
UPLOADS_UNSIGNED_GRACE_END=2026-10-08

# ══════════ worker 水平扩容 ══════════
# worker 副本数：WORKER_REPLICAS=10 docker compose up -d（变更后 compose 自动增减容器）
# 总吞吐 ≈ WORKER_REPLICAS × WORKER_TASK_CONCURRENCY，仍受企业/模型并发上限约束
#
# 高并发基准（4H8G 单机、企业/模型并发 500、1K 图）：REPLICAS=3 × CONCURRENCY=64
# ≈ 192 任务在途；稳态吞吐实际由入方向下载带宽决定（12M ≈ 45-90 张/分钟）。
# PG/Redis 已是 1Panel 外部实例——扩副本前在 1Panel 侧核对：
#   PostgreSQL max_connections ≥ WORKER_REPLICAS × WORKER_DB_POOL_MAX + web 10 + 余量（默认 100）
#   Redis 淘汰策略必须保持 noeviction（默认即是），深积压时上调 maxmemory（≥512mb）
WORKER_REPLICAS=2
# worker 进程的 PG 连接池上限（web 进程固定默认 10）
WORKER_DB_POOL_MAX=30

# ══════════ 镜像源（构建加速，默认国内源）══════════
# 基础镜像默认走 DaoCloud 的 Docker Hub 镜像，npm 包默认走 npmmirror；
# 海外部署时在 .env 覆盖为官方源：
#   NODE_IMAGE=node:22-alpine
#   NPM_REGISTRY=https://registry.npmjs.org
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NPM_REGISTRY=https://registry.npmmirror.com

# ── 样机渲染外部服务（psd-render-api）──
# 仅开发兜底：未在超管平台为企业配置时的回退；生产以超管配置为准
MOCKUP_API_BASE_URL=
MOCKUP_API_KEY=
MOCKUP_COST_PER_RENDER=
